# Copy to config/apps.yaml for local overrides (gitignored).
# Production allowlists go to SSM — never commit real consumer domains.

WELLS_LISTEN_ADDR=:8080
WELLS_APPS_CONFIG=config/apps.example.yaml
WELLS_TURNSTILE_MODE=skip
WELLS_NOTIFIER=stdout
WELLS_LOG_LEVEL=info
