# Copy to config/apps.yaml for local overrides (gitignored).
# Production allowlists go to SSM — never commit real consumer domains.
# Each app in the YAML must set notificationEmail and fromEmail (see config/apps.example.yaml).

WELES_LISTEN_ADDR=:8080
WELES_APPS_CONFIG=config/apps.example.yaml
WELES_TURNSTILE_MODE=skip
WELES_NOTIFIER=stdout
WELES_LOG_LEVEL=info
# WELES_TURNSTILE_SECRET=
# WELES_TURNSTILE_SSM=/weles/prod/turnstile-secret
# WELES_APPS_SSM=/weles/prod/apps
# WELES_APPS_RELOAD_SECONDS=300
# WELES_TRUST_PROXY_XFF=false
# WELES_NOTIFIER=ses
# AWS_REGION=eu-central-1
# WELES_API_STAGE=prod
